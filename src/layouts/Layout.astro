---
import { contact, areas } from '../content/site';
const { title = 'A Gomes Advogados Associados', description = 'Advocacia estratégica, ética e personalizada em São Paulo e em todo o Brasil.', canonical = 'https://agomesadvogados.com.br/' } = Astro.props;
const gaId = import.meta.env.PUBLIC_GA_ID;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
    {gaId && <script is:inline define:vars={{ gaId }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',gaId);</script>}
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a href="/" class="brand" aria-label="A Gomes Advogados Associados - página inicial">
          <img src="/logo-horizontal.png" alt="A Gomes Sociedade de Advogados" />
        </a>
        <nav aria-label="Navegação principal">
          <a href="/sobre">Sobre</a>
          <div class="nav-dropdown">
            <a href="/areas-de-atuacao" class="nav-dropdown-trigger" aria-haspopup="true">Áreas de atuação <span aria-hidden="true">⌄</span></a>
            <div class="nav-dropdown-menu" aria-label="Áreas de atuação">
              {areas.map((area) => <a href={`/areas-de-atuacao/${area.slug}`}>{area.name}</a>)}
            </div>
          </div>
          <a href="/equipe">Equipe</a>
          <a href="/faq">Dúvidas frequentes</a>
          <a href="/contato" class="nav-cta">Fale conosco</a>
        </nav>
        <button class="menu-toggle" aria-label="Abrir menu" aria-expanded="false">☰</button>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div><img class="footer-logo" src="/logo-negativo.png" alt="A Gomes Advogados Associados" /><p class="footer-note">Transformando desafios jurídicos complexos em soluções eficazes e personalizadas.</p></div>
        <div><p class="footer-label">Contato</p><a class="footer-contact-link" href={contact.phoneHref}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5 8.8 3l2.1 5-2.2 1.7a15.7 15.7 0 0 0 5.6 5.6l1.7-2.2 5 2.1-.5 2.2a2.6 2.6 0 0 1-2.8 2.1A16.7 16.7 0 0 1 4.5 6.3a2.6 2.6 0 0 1 2.1-2.8Z" /></svg>{contact.phoneDisplay}</a><a class="footer-contact-link" href={`mailto:${contact.email}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 5.5h17v13h-17v-13Zm1.3 1.4 7.2 5.4 7.2-5.4M4.2 17.1l5.2-4m10.4 4-5.2-4" /></svg>{contact.email}</a></div>
        <div><p class="footer-label">Sede</p><a class="footer-contact-link footer-address" href={contact.maps} target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.1 7-12A7 7 0 0 0 5 9c0 5.9 7 12 7 12Zm0-9.1a2.9 2.9 0 1 0 0-5.8 2.9 2.9 0 0 0 0 5.8Z" /></svg><span>{contact.address} ↗</span></a></div>
        <div><p class="footer-label">Atendimento</p><p>Segunda a sexta<br />08h30 às 16h30</p><p>São Paulo e atendimento online em todo o Brasil</p></div>
        <div><p class="footer-label">Acompanhe</p><a class="social-link instagram-link" href={contact.instagram} target="_blank" rel="noreferrer" aria-label="Instagram da A Gomes"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none" /></svg><span>Instagram</span></a><a href="/privacidade">Política de privacidade</a></div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} A Gomes Advogados Associados. Todos os direitos reservados.</span><span>Site produzido por <a href="https://digitaltimes.com.br?utm_source=cliente&utm_medium=agomesadvogados" target="_blank" rel="noreferrer">Digital Times</a> · OAB/SP</span></div>
    </footer>
    <a class="whatsapp-float" href={contact.whatsappHref} target="_blank" rel="noreferrer" aria-label="Falar pelo WhatsApp"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.2A12.75 12.75 0 0 0 5.06 22.5L3.2 28.8l6.5-1.8A12.8 12.8 0 1 0 16 3.2Zm0 23.4a10.6 10.6 0 0 1-5.4-1.48l-.39-.23-3.86 1.07 1.04-3.76-.25-.4A10.6 10.6 0 1 1 16 26.6Zm5.82-7.95c-.32-.16-1.88-.93-2.17-1.04-.29-.1-.5-.16-.71.16-.21.31-.81 1.03-.99 1.24-.18.21-.36.24-.67.08-.32-.16-1.33-.49-2.53-1.56-.94-.84-1.57-1.87-1.75-2.19-.18-.31-.02-.48.14-.64.14-.14.32-.36.47-.54.16-.18.21-.31.32-.52.1-.21.05-.39-.03-.55-.08-.16-.71-1.72-.97-2.35-.26-.62-.52-.54-.71-.55h-.6c-.21 0-.55.08-.84.39-.29.31-1.1 1.08-1.1 2.64 0 1.56 1.13 3.07 1.29 3.28.16.21 2.22 3.38 5.37 4.74.75.32 1.33.51 1.79.65.75.24 1.43.21 1.97.13.6-.09 1.88-.77 2.14-1.51.26-.75.26-1.39.18-1.52-.08-.13-.29-.21-.6-.36Z" fill="currentColor"/></svg><span>WhatsApp</span></a>
    <div class="cookie-banner" data-cookie-banner hidden><p>Utilizamos cookies essenciais e, se configurado, ferramentas de análise para melhorar a experiência. <a href="/privacidade">Saiba mais</a>.</p><button data-cookie-accept>Aceitar</button></div>
    <script is:inline>
      const toggle = document.querySelector('.menu-toggle'); const nav = document.querySelector('nav');
      toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('is-open', !open); });
      const banner = document.querySelector('[data-cookie-banner]'); if (localStorage.getItem('agomes-cookie') !== 'accepted') banner?.removeAttribute('hidden'); document.querySelector('[data-cookie-accept]')?.addEventListener('click', () => { localStorage.setItem('agomes-cookie','accepted'); banner?.setAttribute('hidden',''); });
    </script>
  </body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap');
:root{--ink:#171719;--muted:#686563;--paper:#f7f4ef;--white:#fff;--red:#951f29;--red-dark:#67151c;--gold:#b29161;--line:#e2ddd4;--shadow:0 18px 50px rgba(20,17,14,.08)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',Arial,sans-serif;line-height:1.65}a{color:inherit;text-decoration:none}img{max-width:100%;display:block}.container{width:min(1180px,calc(100% - 48px));margin:auto}.site-header{background:rgba(247,244,239,.94);border-bottom:1px solid rgba(226,221,212,.85);position:sticky;top:0;z-index:10;backdrop-filter:blur(10px)}.nav-wrap{height:94px;display:flex;align-items:center;justify-content:space-between;gap:32px}.brand img{width:178px;height:auto}.site-header nav{display:flex;align-items:center;gap:26px;font-size:.84rem;color:#3e3b39}.site-header nav a{transition:color .2s}.site-header nav a:hover{color:var(--red)}.nav-cta{background:var(--ink);color:#fff!important;padding:11px 17px}.menu-toggle{display:none;background:none;border:0;font-size:1.5rem;color:var(--ink)}h1,h2,h3{font-family:'Playfair Display',Georgia,serif;font-weight:600;line-height:1.1;margin:0}h1{font-size:clamp(2.7rem,6vw,5.5rem);letter-spacing:-.04em}h2{font-size:clamp(2.1rem,4vw,3.6rem);letter-spacing:-.03em}h3{font-size:1.35rem}p{margin:0 0 1rem}.eyebrow,.footer-label{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--red);font-weight:600}.eyebrow{margin-bottom:18px}.button{display:inline-flex;align-items:center;gap:12px;padding:14px 21px;background:var(--red);color:#fff;font-size:.82rem;font-weight:600;letter-spacing:.03em;transition:background .2s,transform .2s}.button:hover{background:var(--red-dark);transform:translateY(-2px)}.button.outline{background:transparent;color:var(--ink);border:1px solid var(--ink)}.button.outline:hover{background:var(--ink);color:#fff}.hero{padding:clamp(80px,11vw,150px) 0 110px;background:radial-gradient(circle at 80% 30%,rgba(149,31,41,.08),transparent 32%),var(--paper)}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:80px;align-items:center}.hero h1{max-width:710px}.hero h1 em{color:var(--red);font-style:normal}.hero-copy{max-width:520px;color:var(--muted);font-size:1.08rem;margin:26px 0 34px}.hero-actions{display:flex;gap:14px;flex-wrap:wrap}.hero-aside{border-left:1px solid var(--gold);padding-left:36px}.hero-aside p{font-family:'Playfair Display',Georgia,serif;font-size:1.55rem;line-height:1.35}.hero-aside span{display:block;color:var(--muted);font:500 .76rem 'DM Sans',sans-serif;letter-spacing:.1em;text-transform:uppercase;margin-top:28px}.section{padding:110px 0}.section.alt{background:#fff}.section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:42px}.section-head p{max-width:430px;color:var(--muted)}.intro-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:90px;align-items:start}.intro-grid p{color:var(--muted);font-size:1.1rem}.rule{height:1px;background:var(--line);margin:30px 0}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:52px}.stat{border-top:2px solid var(--red);padding-top:16px}.stat strong{font:600 2rem 'Playfair Display',serif;display:block}.stat span{color:var(--muted);font-size:.85rem}.area-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.area-card{background:var(--paper);padding:30px;min-height:190px;display:flex;flex-direction:column;justify-content:space-between;transition:background .2s}.area-card:hover{background:#fff}.area-card h3{margin:12px 0}.area-card p{color:var(--muted);font-size:.9rem}.card-link{color:var(--red);font-size:.78rem;font-weight:600;text-transform:uppercase;letter-spacing:.09em}.split-visual{display:grid;grid-template-columns:1fr 1fr;min-height:500px}.visual-image{background:linear-gradient(100deg,rgba(10,10,10,.35),rgba(10,10,10,.05)),url('/escritorio.jpg') center/cover}.visual-copy{padding:80px max(40px,8vw);background:var(--ink);color:#fff;display:flex;flex-direction:column;justify-content:center}.visual-copy p{color:#c7c3bd;max-width:470px}.team-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.team-card{background:#fff;padding:28px}.avatar{background:linear-gradient(145deg,#271f1f,#8b1d26);aspect-ratio:1;display:grid;place-items:center;color:#fff;font:3rem 'Playfair Display',serif;margin-bottom:20px}.team-card .role{color:var(--red);font-size:.78rem;font-weight:600;text-transform:uppercase;letter-spacing:.1em}.team-card p{color:var(--muted);font-size:.9rem;margin-top:13px}.cta-band{background:var(--red);color:#fff;padding:70px 0}.cta-band .container{display:flex;justify-content:space-between;align-items:center;gap:30px}.cta-band p{color:#f3dfe0;max-width:480px}.cta-band .button{background:#fff;color:var(--red)}.page-hero{padding:88px 0 70px;background:var(--ink);color:#fff}.page-hero p{color:#c8c2bb;max-width:600px;margin-top:20px}.breadcrumbs{font-size:.76rem;color:#b29161;margin-bottom:20px}.prose{max-width:820px}.prose p,.prose li{color:var(--muted);font-size:1.05rem}.prose ul{padding-left:20px}.detail-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:80px}.demand-list{border-top:1px solid var(--line);margin-top:18px}.demand-list li{list-style:none;border-bottom:1px solid var(--line);padding:16px 0;color:var(--muted)}.demand-list li:before{content:'—';color:var(--red);margin-right:12px}.faq-list{max-width:850px}.faq-item{border-top:1px solid var(--line)}.faq-item:last-child{border-bottom:1px solid var(--line)}.faq-item summary{cursor:pointer;padding:22px 0;font:600 1.13rem 'Playfair Display',serif;list-style:none}.faq-item summary::-webkit-details-marker{display:none}.faq-item summary:after{content:'+';float:right;color:var(--red);font:1.5rem 'DM Sans'}.faq-item[open] summary:after{content:'−'}.faq-item p{color:var(--muted);max-width:730px;padding:0 40px 22px 0}.contact-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}.contact-list{display:grid;gap:22px}.contact-item small{display:block;text-transform:uppercase;letter-spacing:.13em;color:var(--red);font-size:.7rem;font-weight:600}.contact-item a,.contact-item p{display:block;margin-top:4px;color:var(--muted)}form{background:#fff;padding:34px;box-shadow:var(--shadow)}.field{display:grid;gap:7px;margin-bottom:18px}.field label{font-size:.78rem;font-weight:600}.field input,.field textarea{border:1px solid var(--line);padding:13px 14px;background:#fff;font:inherit;color:var(--ink)}.field textarea{min-height:130px;resize:vertical}.form-note{font-size:.74rem;color:var(--muted);margin-top:14px}.site-footer{background:#111;color:#eee;padding:70px 0 25px}.footer-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px}.footer-logo{filter:brightness(0) invert(1);width:176px;margin-bottom:20px}.footer-note{color:#a8a39b;max-width:270px;font-size:.85rem}.footer-label{color:#bc9260;margin-bottom:13px}.footer-grid a,.footer-grid p:not(.footer-label){display:block;color:#bcb7b1;font-size:.84rem;margin-bottom:8px}.social-link{color:#fff!important}.footer-bottom{border-top:1px solid #302f2d;margin-top:55px;padding-top:20px;display:flex;justify-content:space-between;color:#817d77;font-size:.73rem}.whatsapp-float{position:fixed;right:24px;bottom:24px;background:#208c5b;color:#fff;border-radius:30px;padding:11px 17px;z-index:8;font-size:.78rem;box-shadow:0 10px 30px rgba(0,0,0,.2)}.whatsapp-float:first-letter{font-size:1.1rem}.cookie-banner{position:fixed;bottom:0;left:0;right:0;background:#1b1a19;color:#fff;padding:14px 5%;z-index:20;display:flex;align-items:center;justify-content:center;gap:20px;font-size:.78rem}.cookie-banner p{margin:0}.cookie-banner a{color:#e1bb8a;text-decoration:underline}.cookie-banner button{border:1px solid #e1bb8a;background:transparent;color:#fff;padding:8px 18px;cursor:pointer}
@media(max-width:800px){.container{width:min(100% - 34px,600px)}.nav-wrap{height:78px}.brand img{width:145px}.menu-toggle{display:block}.site-header nav{display:none;position:absolute;top:78px;left:0;right:0;background:var(--paper);border-bottom:1px solid var(--line);padding:18px 24px;flex-direction:column;align-items:stretch;gap:0}.site-header nav.is-open{display:flex}.site-header nav a{padding:12px}.hero{padding:72px 0}.hero-grid,.intro-grid,.detail-grid,.contact-grid{grid-template-columns:1fr;gap:42px}.hero-aside{padding-left:20px}.section{padding:75px 0}.section-head,.cta-band .container{display:block}.section-head .button,.cta-band .button{margin-top:20px}.area-grid,.team-grid{grid-template-columns:1fr}.split-visual{display:flex;flex-direction:column}.visual-image{min-height:280px}.visual-copy{padding:55px 34px}.stats{gap:12px}.stat strong{font-size:1.5rem}.footer-grid{grid-template-columns:1fr 1fr;gap:32px}.footer-bottom{margin-top:35px}.whatsapp-float span{display:none}.whatsapp-float{padding:14px 16px;border-radius:50%}.cookie-banner{display:block;padding:15px 18px}.cookie-banner button{margin-top:8px}}
 .visual-image{background:radial-gradient(circle at 65% 35%,rgba(166,38,47,.9),transparent 28%),linear-gradient(135deg,#0f1011 0%,#272224 54%,#741922 100%)!important;position:relative}.visual-image:after{content:'AG';position:absolute;inset:0;display:grid;place-items:center;color:rgba(255,255,255,.08);font:clamp(8rem,18vw,16rem) 'Playfair Display',serif}
 .hero{background:#080b10;color:#fff;position:relative;overflow:hidden;padding-top:clamp(90px,12vw,156px)}.hero:before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 76% 45%,rgba(149,31,41,.2),transparent 36%);pointer-events:none}.hero-grid{position:relative;z-index:1;grid-template-columns:minmax(0,1fr) minmax(380px,1.05fr);gap:56px;align-items:stretch}.hero h1{color:#f8f4ec;max-width:680px;font-size:clamp(2.9rem,6vw,5.65rem)}.hero h1 em{color:#f8f4ec}.hero-copy{color:#c9cbd0;max-width:570px}.hero .button.outline{color:#fff;border-color:rgba(255,255,255,.62)}.hero .button.outline:hover{background:#fff;color:var(--ink)}.hero-visual{min-height:560px;position:relative;overflow:hidden;background:radial-gradient(circle at 58% 34%,rgba(171,37,46,.72),transparent 24%),linear-gradient(120deg,#11151b 0%,#21171a 50%,#08090b 100%);box-shadow:0 24px 70px rgba(0,0,0,.32)}.hero-visual:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,11,16,.15),rgba(8,11,16,.02)),repeating-linear-gradient(90deg,transparent 0 96px,rgba(255,255,255,.035) 97px 99px);opacity:.7}.hero-visual:after{content:'A GOMES';position:absolute;right:8%;bottom:8%;color:rgba(255,255,255,.09);font:600 clamp(2.2rem,5vw,5rem) 'Playfair Display',serif;letter-spacing:.08em}
 .hero .eyebrow{color:#d9ae77}
@media(max-width:800px){.hero-grid{grid-template-columns:1fr;gap:38px}.hero-visual{min-height:330px}.hero{padding-top:70px}}
 .site-header{background:#080b10;border-bottom-color:rgba(255,255,255,.12)}.site-header nav{color:#e7e4de}.site-header nav a:hover{color:#d9ae77}.site-header .nav-cta{background:#b29161;color:#111!important}.brand img{width:178px;max-height:76px;object-fit:contain;mix-blend-mode:normal}.cookie-banner[hidden]{display:none}
 .hero{min-height:calc(100svh - 94px);display:flex;align-items:center;padding:0;background:#080b10}.hero:before{display:none}.hero-grid{min-height:calc(100svh - 94px);grid-template-columns:.86fr 1.14fr;gap:0;max-width:1280px;width:100%}.hero-copy-column{display:flex;flex-direction:column;justify-content:center;padding:72px clamp(28px,5vw,82px) 72px 0;position:relative;z-index:2}.hero h1{font-size:clamp(2.45rem,4vw,4.1rem);letter-spacing:-.045em}.hero-visual{height:100%;min-height:calc(100svh - 94px);opacity:.66;background:url('/escritorio.jpg') center center/cover no-repeat;filter:brightness(.58) saturate(.82);mix-blend-mode:normal;box-shadow:none}.hero-visual:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#080b10 0%,rgba(8,11,16,.86) 7%,rgba(8,11,16,.38) 25%,rgba(8,11,16,.08) 52%,rgba(8,11,16,0) 78%);pointer-events:none}.hero-visual:after{content:none}
@media(max-width:800px){.hero{min-height:auto;padding:0}.hero-grid{min-height:auto;grid-template-columns:1fr}.hero-copy-column{padding:64px 0 50px}.hero-visual{height:330px;min-height:330px;opacity:.78}.brand img{width:160px;max-height:64px}}
 .service-audience{color:var(--muted);font-size:1.02rem;margin:0 0 30px}.service-demand-label{margin-top:34px;margin-bottom:0}.whatsapp-float{display:inline-flex;align-items:center;gap:8px}.whatsapp-float svg{width:25px;height:25px;flex:none}.footer-logo{filter:none}.footer-contact-link{display:flex!important;align-items:flex-start;gap:9px}.footer-contact-link svg{width:16px;height:16px;flex:none;margin-top:3px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.footer-address{max-width:245px}.footer-address span{flex:1}
